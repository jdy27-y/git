<!--pages/user/user.wxml-->
<view class="container">
  <!-- 用户信息 -->
  <view class="user-section card">
    <view class="user-avatar" wx:if="{{userInfo.avatarUrl}}">
      <image src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
    </view>
    <view class="user-avatar default" wx:else>
      <text>👤</text>
    </view>
    <view class="user-info">
      <view class="user-name">{{userInfo.nickName || '未登录'}}</view>
      <view class="user-phone" wx:if="{{userInfo.phone}}">手机：{{userInfo.phone}}</view>
    </view>
    <button class="btn-get-info" wx:if="{{!userInfo.nickName}}" bindtap="getUserProfile">
      获取头像昵称
    </button>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section card">
    <view class="menu-item" bindtap="goOrderList">
      <text class="menu-icon">📋</text>
      <text class="menu-text">我的订单</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goSubscribe">
      <text class="menu-icon">🔔</text>
      <text class="menu-text">消息通知</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item">
      <text class="menu-icon">📞</text>
      <text class="menu-text">联系客服</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item">
      <text class="menu-icon">📍</text>
      <text class="menu-text">常用地址</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 关于 -->
  <view class="about-section card">
    <view class="menu-item">
      <text class="menu-icon">ℹ️</text>
      <text class="menu-text">关于我们</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>
