/* 订阅消息授权页样式 */
.auth-section {
  text-align: center;
  padding: 60rpx 40rpx;
}

.auth-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.auth-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.auth-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
}

.auth-list {
  text-align: left;
  margin-bottom: 40rpx;
}

.auth-item {
  font-size: 28rpx;
  padding: 12rpx 0;
  color: #333;
}

.skip-text {
  margin-top: 30rpx;
  font-size: 26rpx;
  color: #999;
}
