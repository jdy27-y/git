<!--pages/order/confirm.wxml-->
<view class="container">
  <!-- 商家信息 -->
  <view class="shop-info card">
    <text class="shop-name">🏪 {{shopName}}</text>
  </view>

  <!-- 商品列表 -->
  <view class="goods-list card">
    <view class="goods-item" wx:for="{{cartItems}}" wx:key="_id">
      <view class="goods-name">{{item.name}}</view>
      <view class="goods-right">
        <text class="goods-price">¥{{item.price}}</text>
        <text class="goods-qty">×{{item.quantity}}</text>
      </view>
    </view>
    <view class="divider"></view>
    <view class="total-row">
      <text>合计</text>
      <text class="price">¥{{totalPrice}}</text>
    </view>
  </view>

  <!-- 取餐时间 -->
  <view class="pickup-section card">
    <view class="section-title">取餐时间</view>
    <view class="time-list">
      <view class="time-item {{selectedTime === item ? 'active' : ''}}" 
            wx:for="{{timeSlots}}" wx:key="*this"
            bindtap="selectTime" data-time="{{item}}">
        {{item}}
      </view>
    </view>
  </view>

  <!-- 联系方式 -->
  <view class="contact-section card">
    <view class="section-title">联系方式</view>
    <view class="input-row">
      <text class="label">手机号后四位</text>
      <input class="input" type="number" maxlength="4" 
             placeholder="请输入手机号后四位"
             bindinput="inputPhone" value="{{contactLast4}}" />
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-area">
    <button class="btn-primary" bindtap="submitOrder">提交订单</button>
  </view>
</view>
