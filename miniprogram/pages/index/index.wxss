/* 首页样式 */
.search-bar {
  background: #fff;
  border-radius: 32rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.search-bar input {
  font-size: 28rpx;
  color: #333;
}

/* 商家卡片 */
.shop-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.shop-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.shop-avatar image {
  width: 100%;
  height: 100%;
}

.shop-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.shop-name {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 500;
}

.shop-name .tag {
  margin-left: 12rpx;
}

.shop-meta {
  display: flex;
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}

.shop-meta .distance {
  margin-right: 24rpx;
}

.shop-notice {
  font-size: 22rpx;
  color: #ff8c00;
  margin-top: 8rpx;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
}
